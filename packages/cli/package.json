{
  "name": "@volatodev/cli",
  "version": "0.1.0-beta.19",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "description": "Volato Errors CLI — production evidence for coding agents.",
  "license": "MIT",
  "author": "Wrenchy SASU",
  "homepage": "https://github.com/volatodev/javascript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volatodev/javascript.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/volatodev/javascript/issues"
  },
  "keywords": [
    "volato",
    "cli",
    "error-tracking",
    "observability",
    "ai-agents"
  ],
  "bin": {
    "volato": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "skills",
    "!skills/**/__tests__/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:browser-js": "node scripts/generate-browser-javascript-runtime.mjs",
    "generate:nextjs-js": "node scripts/generate-nextjs-javascript-runtime.mjs",
    "generate:node-js": "node scripts/generate-node-javascript-runtime.mjs",
    "generate:runtimes": "pnpm generate:nextjs-js && pnpm generate:browser-js && pnpm generate:node-js",
    "bundle": "pnpm generate:runtimes && tsup",
    "build": "pnpm bundle && pnpm docs:generate",
    "docs:bundle": "tsup --config tsup.documentation.config.ts",
    "docs:generate": "pnpm docs:bundle && node ../../scripts/generate-documentation-contract.mjs",
    "docs:check": "pnpm docs:bundle && node ../../scripts/generate-documentation-contract.mjs --check",
    "dev": "pnpm generate:runtimes && tsup --watch",
    "lint": "pnpm generate:runtimes && tsc --noEmit",
    "typecheck": "pnpm generate:runtimes && tsc --noEmit",
    "test": "pnpm generate:runtimes && vitest run",
    "clean": "rm -rf dist .documentation-build .turbo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@volatodev/read-client": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "commander": "^14.0.3",
    "esbuild": "0.28.1",
    "happy-dom": "^20.10.6",
    "next": "^15.5.21",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
