{
  "name": "@volatodev/cli",
  "version": "0.1.0-beta.17",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "description": "Volato Errors CLI — production evidence for coding agents.",
  "license": "MIT",
  "author": "Wrenchy SASU",
  "homepage": "https://github.com/volatodev/javascript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volatodev/javascript.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/volatodev/javascript/issues"
  },
  "keywords": [
    "volato",
    "cli",
    "error-tracking",
    "observability",
    "ai-agents"
  ],
  "bin": {
    "volato": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "skills",
    "!skills/**/__tests__/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "commander": "^14.0.3",
    "esbuild": "0.28.1",
    "happy-dom": "^20.10.6",
    "next": "^15.5.21",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
