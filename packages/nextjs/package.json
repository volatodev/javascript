{
  "name": "@volatodev/nextjs",
  "version": "0.0.0",
  "type": "module",
  "description": "Next.js error tracking SDK — captures errors across all Next.js runtimes and streams them to Volato.",
  "license": "MIT",
  "author": "Wrenchy SASU",
  "homepage": "https://github.com/volatodev/javascript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volatodev/javascript.git",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/volatodev/javascript/issues"
  },
  "keywords": [
    "volato",
    "nextjs",
    "error-tracking",
    "observability",
    "mcp",
    "sdk",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "volato": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@volatodev/core": "workspace:*",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
